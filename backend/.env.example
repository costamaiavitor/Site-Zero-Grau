# Copie para backend/.env e preencha. O .env NUNCA vai para o GitHub.
# Num serviço de nuvem (Render, Railway…), estas mesmas variáveis vão no painel dele.

# --- Banco MySQL (no Aiven: Overview do serviço → Connection information) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# SSL fica ligado fora do localhost. Para conferir o certificado do Aiven,
# baixe o "CA certificate" e aponte o caminho (relativo à pasta backend):
# DB_SSL_CA=ca.pem
# DB_SSL=false   # só para um MySQL local sem SSL

# --- Segurança ---
# Texto aleatório e longo (16+ caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Administrador ---
# Criado ao subir o servidor, se ainda não existir conta com esse e-mail.
# Conta que já existe só vira admin se a senha for esta mesma.
ADMIN_EMAIL=admin@zerograu.com.br
ADMIN_SENHA=

# --- Servidor ---
PORT=3000
# NODE_ENV=production   # liga o redirecionamento para https
# CORS_ORIGENS=https://meu-dominio.com.br   # outros endereços do site, separados por vírgula
# CONFERIR_DIGITO=true  # recusa CPF/CNPJ com dígito verificador errado
# SERVIR_SITE=false     # não entrega a pasta frontend/ junto com a API
